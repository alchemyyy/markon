{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "markon",
  "version": "../package.json",
  "identifier": "com.getmarkon.markon",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "markon",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "cli": {
      "description": "Minimal distraction-free live Markdown editor",
      "args": [
        {
          "name": "files",
          "takesValue": true,
          "multiple": true,
          "index": 1
        }
      ]
    }
  }
}
